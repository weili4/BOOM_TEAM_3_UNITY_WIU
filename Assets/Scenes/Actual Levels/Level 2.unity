    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[0].sentence
      value: ...Barbara?
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[1].sentence
      value: Oh thank god. Finally.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[2].sentence
      value: You good? You look like you fought a wall.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[3].sentence
      value: "I\u2014 no. I mean, kind of. There was a wall. It won."
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[4].sentence
      value: Cool.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[5].sentence
      value: Anyway! There's a keycard somewhere up there, we need it to get through.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[6].sentence
      value: ...That's not a small climb.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[7].sentence
      value: Yeah well, lucky for you, I'm literally built for this. Fast, agile,
        dashy. I can get up there in like two seconds.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[8].sentence
      value: You show off.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[9].sentence
      value: You're welcome.
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[1].hasChoices
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[2].shakeForce
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
      propertyPath: dialogueLines.Array.data[1].speakerName
      value: Barbara
      objectReference: {fileID: 0}
    - target: {fileID: 3169902739311595065, guid: 64e51705bf6ce5d4d8987fd077698019, type: 3}
